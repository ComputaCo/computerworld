{
  "name": "computerworld-cloud",
  "version": "0.4.0",
  "description": "A small client for the hosted ComputerWorld API: templates, environments, agents, societies and forks over HTTP.",
  "type": "module",
  "main": "./computerworld-cloud.mjs",
  "types": "./computerworld-cloud.d.mts",
  "exports": {
    ".": {
      "types": "./computerworld-cloud.d.mts",
      "default": "./computerworld-cloud.mjs"
    },
    "./cw-ssh-transport.mjs": "./cw-ssh-transport.mjs"
  },
  "files": [
    "computerworld-cloud.mjs",
    "computerworld-cloud.d.mts",
    "cw-ssh-transport.mjs",
    "bin/cw-ssh-proxy.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs test/transport.test.mjs",
    "test:live": "node --test test/live.test.mjs",
    "typecheck": "tsc -p ."
  },
  "license": "MIT",
  "homepage": "https://computaco.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComputaCo/computerworld.git"
  },
  "sideEffects": false,
  "bin": {
    "cw-ssh-proxy": "./bin/cw-ssh-proxy.mjs"
  }
}
